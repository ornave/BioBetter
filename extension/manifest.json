{
  "manifest_version": 3,
  "name": "BioBetter",
  "version": "1.2.1",
  "description": "A calmer BioPlus: readable notebooks, clear course progress, and organized study materials. Switch back anytime.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "BioBetter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://bioplus.co.il/notebook/*",
        "https://www.bioplus.co.il/notebook/*"
      ],
      "css": [
        "reader.css",
        "typography.css"
      ],
      "js": [
        "vendor/katex.min.js",
        "math.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bioplus.co.il/course/*",
        "https://www.bioplus.co.il/course/*"
      ],
      "css": [
        "course.css",
        "typography.css"
      ],
      "js": [
        "course.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bioplus.co.il/subsubject/*",
        "https://www.bioplus.co.il/subsubject/*"
      ],
      "css": [
        "subsubject.css",
        "typography.css"
      ],
      "js": [
        "subsubject.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
